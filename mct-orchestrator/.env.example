MESH_CONTROLLER_URL=https://mesh.example.internal/api/v1
MESH_AUTH_TOKEN=replace-with-real-secret
MESH_REQUEST_TIMEOUT=10

# HMAC key shared only between the trusted hotspot gateway and this verifier.
# Use a random secret of at least 32 characters; do not commit the real value.
SHB_ATTESTATION_SECRET=replace-with-a-random-secret-at-least-32-chars
SHB_ATTESTATION_AUDIENCE=mct-backoffice
SHB_ATTESTATION_ISSUER=shb-hotspot-gateway
